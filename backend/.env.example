# Backend environment file. Copy to backend/.env and adjust if needed —
# these are safe, non-secret local-development placeholder values.
# scripts/dev-setup.sh does this for you automatically on a fresh clone.
#
# Note: docker-compose.yml (Postgres, Redis) has its own working defaults
# and does not read this file — it lives at the repo root, this one lives
# in backend/, matching where src/core/config.py actually loads ".env"
# from (relative to the backend process's working directory).

# Combined Postgres connection string (feature 005: docker compose up -d
# brings up a matching local Postgres + pgvector container on the default
# port/credentials below).
DATABASE_URL=postgresql://paddockbook:paddockbook@localhost:5432/paddockbook

# Backend JWT signing secret (backend/src/core/config.py). This placeholder
# is fine for local development only — generate a real random secret before
# ever deploying (e.g. `openssl rand -hex 32`), and never commit a real one.
# At least 32 bytes, or PyJWT warns about HMAC key length (RFC 7518 3.2).
JWT_SECRET=local-development-only-secret-please-change-before-deploying

# Whether the refresh-token cookie is marked Secure (HTTPS-only). Leave
# false for local dev over http://localhost — a Secure cookie is silently
# dropped by the browser over plain HTTP. MUST be set to true once actually
# deployed over HTTPS.
COOKIE_SECURE=false

# Which embedding provider ingestion and chat retrieval use (backend/src/core/embeddings.py).
# "bedrock" (default) requires real AWS credentials — leave unset for that.
# "ollama" runs entirely locally, no AWS account needed at all — the
# recommended way to prove the RAG pipeline works before ever touching
# production infrastructure. Requires both Ollama models pulled first:
#   ollama pull llama3.2            # chat generation
#   ollama pull mxbai-embed-large   # embeddings (1024 dimensions —
#                                   # matches the vector(1024) column)
# Ingested content and chat queries must use the same provider, since each
# produces vectors in a different embedding space — don't switch this
# after you've already ingested documents with the other provider.
EMBEDDING_PROVIDER=bedrock
