# Local Postgres + pgvector (docker-compose). Copy to .env and adjust if
# needed — these are safe, non-secret local-development placeholder values.
# scripts/dev-setup.sh does this for you automatically on a fresh clone.

POSTGRES_DB=paddockbook
POSTGRES_USER=paddockbook
POSTGRES_PASSWORD=paddockbook
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Combined connection string, for whichever backend code connects directly.
DATABASE_URL=postgresql://paddockbook:paddockbook@localhost:5432/paddockbook

# Backend JWT signing secret (backend/src/core/config.py). This placeholder
# is fine for local development only — generate a real random secret before
# ever deploying (e.g. `openssl rand -hex 32`), and never commit a real one.
JWT_SECRET=local-development-only-secret

# Whether the refresh-token cookie is marked Secure (HTTPS-only). Leave
# false for local dev over http://localhost — a Secure cookie is silently
# dropped by the browser over plain HTTP. MUST be set to true once actually
# deployed over HTTPS.
COOKIE_SECURE=false

# Which embedding provider ingestion and chat retrieval use (backend/src/core/embeddings.py).
# "bedrock" (default) requires real AWS credentials — leave unset for that.
# "ollama" runs entirely locally against `ollama_embedding_model` (default
# mxbai-embed-large, 1024 dimensions — matches the vector(1024) column) for
# prototyping without AWS. Ingested content and chat queries must use the
# same provider, since each produces vectors in a different embedding space.
EMBEDDING_PROVIDER=bedrock
