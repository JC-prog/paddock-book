{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: serve",
      "type": "shell",
      "command": "npx ng serve --port 4200",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Application bundle generation complete\\."
        }
      }
    }
  ]
}
